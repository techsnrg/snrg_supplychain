{
  "doctype": "DocType",
  "name": "Daily Production Item",
  "module": "Supply Chain",
  "engine": "InnoDB",
  "field_order": [
    "item_code",
    "qty",
    "item_name",
    "uom",
    "bom_no",
    "stock_entry",
    "status",
    "error"
  ],
  "fields": [
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "label": "Item Code",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "Produced Quantity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item_name",
      "fieldtype": "Data",
      "label": "Item Name",
      "read_only": 1
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "Uom",
      "options": "UOM",
      "read_only": 1
    },
    {
      "fieldname": "bom_no",
      "fieldtype": "Link",
      "label": "Bom No",
      "options": "BOM",
      "read_only": 1
    },
    {
      "fieldname": "stock_entry",
      "fieldtype": "Link",
      "label": "Stock Entry",
      "options": "Stock Entry",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nPosted\nFailed",
      "default": "Pending",
      "read_only": 1
    },
    {
      "fieldname": "error",
      "fieldtype": "Small Text",
      "label": "Error",
      "read_only": 1
    }
  ],
  "istable": 1,
  "permissions": []
}
